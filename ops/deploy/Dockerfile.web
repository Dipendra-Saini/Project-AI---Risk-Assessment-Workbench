# React build served by nginx; /api is proxied to the API container. Build context = repo root.
FROM node:22-alpine AS build
WORKDIR /web
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci
COPY src/frontend ./
RUN npm run build

FROM nginx:1.27-alpine
COPY ops/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 8080
