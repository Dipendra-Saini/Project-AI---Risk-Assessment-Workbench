{
 "uid": "raw-main",
 "title": "Risk Assessment Workbench",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "raw"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Cases reaching committee (p50 / p90 submitted -> decision-ready)",
   "description": "Brief success metric: 5-20 days before, target under 2 days",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(raw_decision_ready_seconds_bucket[1d])))",
     "legendFormat": "p50",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.9, sum by (le) (rate(raw_decision_ready_seconds_bucket[1d])))",
     "legendFormat": "p90",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Workflow transitions",
   "description": "",
