# Copy to .env. Every key is optional: with no LLM keys the system runs in
# offline mode (deterministic heuristic provider) so the demo, tests and evals
# still work at zero cost.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# sqlite (default, zero setup) or postgres+pgvector via docker compose:
# DATABASE_URL=postgresql+psycopg://raw:raw@localhost:5432/raw
DATABASE_URL=sqlite:///./raw.db

# replay | offline | live
LLM_MODE=live
TOKEN_BUDGET_PER_CASE=12000
JWT_SECRET=change-me-in-prod

# Optional Arize Phoenix collector (docker compose starts one on :6006)
OTEL_EXPORTER_OTLP_ENDPOINT=
